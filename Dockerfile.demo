# نسخة العرض فقط (Render أو أي استضافة Docker). الإنتاج بيستعمل Dockerfile العادي.
# عند الإقلاع: migrations ← بيانات وهمية إذا القاعدة فاضية ← الموقع.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 PRISMA_SCHEMA_ENGINE_BINARY=/bin/false
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx prisma generate && npm run build
ENV NODE_ENV=production HOSTNAME=0.0.0.0 DEMO_MODE=true UPLOAD_DIR=/tmp/uploads
CMD ["sh", "scripts/demo-start.sh"]
