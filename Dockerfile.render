# النسخة الرسمية على Render (أو أي استضافة Docker بدون قرص دائم).
# الصور بتنحفظ بقاعدة البيانات (ATTACHMENTS_IN_DB) لأن قرص Render المجاني بينمسح مع كل إقلاع.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 PRISMA_SCHEMA_ENGINE_BINARY=/bin/false
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx prisma generate && npm run build
ENV NODE_ENV=production HOSTNAME=0.0.0.0 ATTACHMENTS_IN_DB=true
CMD ["sh", "scripts/render-start.sh"]
